GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
OAUTH_PORT=8787
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
FIGMA_REDIRECT_URI=http://localhost:5173/oauth/callback
CANVA_REDIRECT_URI=http://localhost:5173/oauth/callback
VITE_OAUTH_API=http://127.0.0.1:8787
VITE_GITHUB_CLIENT_ID=
VITE_FIGMA_CLIENT_ID=
VITE_CANVA_CLIENT_ID=

# Hadi Canvas account API (server-only)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
AUTH_HOST=127.0.0.1
AUTH_PORT=8788
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to use the same origin (Vite/nginx proxies /api/auth and /api/mcp).
# Set only if the account API lives on a different origin.
VITE_AUTH_API=
# Same-site deployment (recommended): Lax. Cross-site only: None + AUTH_HTTPS=1
AUTH_COOKIE_SAMESITE=Lax
AUTH_HTTPS=0
# 0 closes public registration while email verification is unavailable
AUTH_ALLOW_REGISTRATION=1
# Vite proxy target for /api/auth and /api/mcp
AUTH_PROXY_TARGET=http://127.0.0.1:8788

# MCP connector secret encryption (server-only): generate with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MCP_TOKEN_ENCRYPTION_KEY=
