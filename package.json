{
  "name": "hadi-canvas",
  "private": true,
  "version": "3.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import ./tests/ts-resolve.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "oauth": "node --env-file-if-exists=.env server/oauth.mjs",
    "auth": "node --env-file-if-exists=.env server/auth/api.mjs",
    "backup": "node --env-file-if-exists=.env server/backupCli.mjs create",
    "backup:verify": "node --env-file-if-exists=.env server/backupCli.mjs verify",
    "backup:restore": "node --env-file-if-exists=.env server/backupCli.mjs restore",
    "health": "node --env-file-if-exists=.env scripts/health.mjs",
    "smoke": "bash scripts/smoke-local.sh",
    "smoke:flow": "node --env-file-if-exists=.env scripts/smoke-flow.mjs",
    "integrations:check": "node --env-file-if-exists=.env scripts/integrations-check.mjs",
    "start:prod": "bash scripts/start-production.sh",
    "migrate": "node --env-file-if-exists=.env scripts/migrate-schema.mjs",
    "migrate:apply": "node --env-file-if-exists=.env scripts/migrate-schema.mjs --apply"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2",
    "yjs": "13.6.33",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.16"
  },
  "description": "Multi-tenant graph-based AI studio with PostgreSQL identity and project schema foundation"
}
